# Local smoke-test configuration. Do not reuse these values in production.
APP_STAGE=local
APP_NAME=movie
APP_PORT=0.0.0.0:8090
DB_URL=mongodb://mongodb:27017

JWT_ACCESS_SECRET_KEY=local-access-secret
JWT_REFRESH_SECRET_KEY=local-refresh-secret
JWT_API_SECRET_KEY=local-api-secret
JWT_ACCESS_DURATION=15
JWT_REFRESH_DURATION=168

APP_FILE_LIMIT=10485760
APP_GCP_BUCKET=local-unused

# The application currently requires Kafka over TLS + SASL/PLAIN. No plaintext
# Kafka is installed by this smoke-test stack. Queue workers may log a DNS error.
KAFKA_URL=kafka.invalid:9092
KAFKA_API_KEY=local-unused
KAFKA_SECRET_KEY=local-unused

# Omise validates key prefixes while the application starts.
OMISE_PUBLIC_KEY=pkey_test_local_placeholder
OMISE_SECRET_KEY=skey_test_local_placeholder

REDIS_URL=redis:6379

MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_USERNAME=local-unused
MAILER_PASSWORD=local-unused

TICKET_CUSTOMER_URL=customer:8100
TICKET_INVENTORY_URL=inventory:8101
TICKET_MOVIE_URL=movie:8090
TICKET_PAYMENT_URL=payment:8103
TICKET_TICKET_URL=ticket:8102
